{%- macro tax_total(amount, moneda, id, name, code, percent="") -%}
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="{{moneda}}">{{amount}}</cbc:TaxAmount>
            <cac:TaxSubtotal>
                <cbc:TaxAmount currencyID="{{moneda}}">{{amount}}</cbc:TaxAmount>
                <cac:TaxCategory>
                    {%- if percent %}
                    <cbc:Percent>{{percent}}</cbc:Percent>
                    {%- endif %}
                    <cac:TaxScheme>
                        <cbc:ID>{{id}}</cbc:ID>
                        <cbc:Name>{{name}}</cbc:Name>
                        <cbc:TaxTypeCode>{{code}}</cbc:TaxTypeCode>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        </cac:TaxTotal>
{%- endmacro tax_total -%}
<?xml version="1.0" encoding="UTF-8"?>
<SummaryDocuments xmlns="urn:sunat:names:specification:ubl:peru:schema:xsd:SummaryDocuments-1"
                  xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
                  xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
                  xmlns:ccts="urn:un:unece:uncefact:documentation:2" xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                  xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
                  xmlns:ns11="urn:sunat:names:specification:ubl:peru:schema:xsd:Perception-1"
                  xmlns:qdt="urn:oasis:names:specification:ubl:schema:xsd:QualifiedDatatypes-2"
                  xmlns:sac="urn:sunat:names:specification:ubl:peru:schema:xsd:SunatAggregateComponents-1"
                  xmlns:udt="urn:un:unece:uncefact:data:specification:UnqualifiedDataTypesSchemaModule:2"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent />
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>2.0</cbc:UBLVersionID>
    <cbc:CustomizationID>1.1</cbc:CustomizationID>
    <cbc:ID>{{documento_id}}</cbc:ID>
    <cbc:ReferenceDate>{{fecha_emision_comprobantes}}</cbc:ReferenceDate>
    <cbc:IssueDate>{{fecha_emision}}</cbc:IssueDate>
    {%- include "ubl/common/signature.xml" %}
    {%- include "ubl/sunat/include/supplier.xml" %}
    {%- for it in comprobantes %}
    <sac:SummaryDocumentsLine>
        <cbc:LineID>{{loop.index}}</cbc:LineID>
        <cbc:DocumentTypeCode>{{it.comprobante.tipo_comprobante}}</cbc:DocumentTypeCode>
        <cbc:ID>{{it.comprobante.serie_numero}}</cbc:ID>
        <cac:AccountingCustomerParty>
            <cbc:CustomerAssignedAccountID>{{it.comprobante.cliente.numero_documento_identidad}}</cbc:CustomerAssignedAccountID>
            <cbc:AdditionalAccountID>{{it.comprobante.cliente.tipo_documento_identidad}}</cbc:AdditionalAccountID>
        </cac:AccountingCustomerParty>
        {%- if it.comprobante.comprobante_afectado %}
        <cac:BillingReference>
            <cac:InvoiceDocumentReference>
                <cbc:ID>{{it.comprobante.comprobante_afectado.serie_numero}}</cbc:ID>
                <cbc:DocumentTypeCode>{{it.comprobante.comprobante_afectado.tipo_comprobante}}</cbc:DocumentTypeCode>
            </cac:InvoiceDocumentReference>
        </cac:BillingReference>
        {%- endif %}
        {%- if it.comprobante.percepcion %}
        <sac:SUNATPerceptionSummaryDocumentReference>
            <sac:SUNATPerceptionSystemCode>{{it.comprobante.percepcion.tipo_regimen}}</sac:SUNATPerceptionSystemCode>
            <sac:SUNATPerceptionPercent>{{it.comprobante.percepcion.tasa | round_decimal}}</sac:SUNATPerceptionPercent>
            <cbc:TotalInvoiceAmount currencyID="PEN">{{it.comprobante.percepcion.monto | round_decimal}}</cbc:TotalInvoiceAmount>
            <sac:SUNATTotalCashed currencyID="PEN">{{it.comprobante.percepcion.monto_total | round_decimal}}</sac:SUNATTotalCashed>
            <cbc:TaxableAmount currencyID="PEN">{{it.comprobante.percepcion.monto_base | round_decimal}}</cbc:TaxableAmount>
        </sac:SUNATPerceptionSummaryDocumentReference>
        {%- endif %}
        <cac:Status>
            <cbc:ConditionCode>{{it.tipo_operacion}}</cbc:ConditionCode>
        </cac:Status>
        <sac:TotalAmount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.importe_total}}</sac:TotalAmount>
        {%- if it.comprobante.valor_venta.gravado is gt0 %}
        <sac:BillingPayment>
            <cbc:PaidAmount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.gravado}}</cbc:PaidAmount>
            <cbc:InstructionID>01</cbc:InstructionID>
        </sac:BillingPayment>
        {%- endif %}
        {%- if it.comprobante.valor_venta.exonerado is gt0 %}
        <sac:BillingPayment>
            <cbc:PaidAmount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.exonerado}}</cbc:PaidAmount>
            <cbc:InstructionID>02</cbc:InstructionID>
        </sac:BillingPayment>
        {%- endif %}
        {%- if it.comprobante.valor_venta.inafecto is gt0 %}
        <sac:BillingPayment>
            <cbc:PaidAmount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.inafecto}}</cbc:PaidAmount>
            <cbc:InstructionID>03</cbc:InstructionID>
        </sac:BillingPayment>
        {%- endif %}
        {%- if it.comprobante.valor_venta.gratuito is gt0 %}
        <sac:BillingPayment>
            <cbc:PaidAmount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.gratuito}}</cbc:PaidAmount>
            <cbc:InstructionID>05</cbc:InstructionID>
        </sac:BillingPayment>
        {%- endif %}
        {%- if it.comprobante.valor_venta.otros_cargos is gt0 %}
        <cac:AllowanceCharge>
            <cbc:ChargeIndicator>true</cbc:ChargeIndicator>
            <cbc:Amount currencyID="{{it.comprobante.moneda}}">{{it.comprobante.valor_venta.otros_cargos}}</cbc:Amount>
        </cac:AllowanceCharge>
        {%- endif %}
        {{ self::tax_total(amount=it.comprobante.impuestos.igv, percent=it.comprobante.impuestos.igv_tasa, moneda=it.comprobante.moneda, id="1000", name="IGV", code="VAT") }}
        {%- if it.comprobante.impuestos.icb is gt0 %}
        {{ self::tax_total(amount=it.comprobante.impuestos.icb, moneda=it.comprobante.moneda, id="7152", name="ICBPER", code="OTH") }}
        {%- endif %}
        {%- if it.comprobante.impuestos.isc is gt0 %}
        {{ self::tax_total(amount=it.comprobante.impuestos.isc, moneda=it.comprobante.moneda, id="2000", name="ISC", code="EXC") }}
        {%- endif %}
        {%- if it.comprobante.impuestos.ivap is gt0 %}
        {{ self::tax_total(amount=it.comprobante.impuestos.ivap, moneda=it.comprobante.moneda, id="1016", name="IVAP", code="VAT") }}
        {%- endif %}
        {%- if it.comprobante.impuestos.otros is gt0 %}
        {{ self::tax_total(amount=it.comprobante.impuestos.otros, moneda=it.comprobante.moneda, id="9999", name="OTROS", code="OTH") }}
        {%- endif %}
    </sac:SummaryDocumentsLine>
    {%- endfor %}
</SummaryDocuments>
